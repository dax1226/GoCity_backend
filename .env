# Local SQLite (active for development)
DATABASE_URL="sqlite:///./gocity.db"

# Local PostgreSQL (uncomment + comment SQLite above to switch)
# DATABASE_URL="postgresql://postgres:Dhruv%405011@localhost:5432/gocity"

# Production / Supabase (PostGIS enabled by default)
