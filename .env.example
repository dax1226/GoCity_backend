# Core FastAPI settings
SECRET_KEY=replace-with-a-long-random-server-secret
DATABASE_URL=postgresql://user:password@host:5432/gocity

# Required for every /api/admin/* endpoint. Set the identical value in the
# Go-city-admin server environment; never send it to a browser.
ADMIN_API_KEY=replace-with-a-different-long-random-secret

# Privacy-safe request and query timing
LOG_LEVEL=INFO
SLOW_REQUEST_MS=500
SLOW_QUERY_MS=150

# OTP lifecycle (development master-code support is intentionally omitted)
OTP_TTL_SECONDS=300
OTP_RESEND_COOLDOWN_SECONDS=30
OTP_MAX_VERIFY_ATTEMPTS=5
RIDE_OTP_TTL_SECONDS=600
RIDE_OTP_MAX_VERIFY_ATTEMPTS=5
OTP_HASH_SECRET=replace-with-a-distinct-secret
RIDE_OTP_HASH_SECRET=replace-with-a-distinct-secret

# Retention lifecycle
NOTIFICATION_RETENTION_DAYS=90
RETENTION_SWEEP_INTERVAL_SECONDS=86400
LEGACY_RIDE_OTP_MAX_AGE_MINUTES=15
